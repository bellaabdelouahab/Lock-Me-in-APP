<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android checks the private DNS server from inside this app's process before it accepts the host. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reading the active network: the DNS fallback's "network up but not validated" check, and training's Wi-Fi-only rule. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Rough position only, asked when "Use my location" is tapped: fajr needs the city, never more. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- The planner has to see every installed app to suspend it. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Exact alarms for the phase changes (fajr, night, the windows). SCHEDULE_EXACT_ALARM is denied by default from Android 14
         and Android then delays the alarm, so fajr's pass came late; USE_EXACT_ALARM is granted at install (not a Play app). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Updates from GitHub: silent as device owner, Android's own prompt otherwise. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- FilterWatcher: closes the watched apps within seconds when the screen filter is switched off. Device owners may run it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- The mood check: one notification a day, and one after a try on a closed app at most every two hours. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The bank pause (spec D1): switching the screen filter back on after a bank app, and seeing it leave. Neither can be
         granted by the app or the device owner; one adb grant each (docs/FEATURES.md 3.22). Without them the pause still
         works, and the filter is switched back on by hand. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <application
        android:name=".LockMeInApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Lock Me In"
        android:testOnly="${testOnly}"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />

        <activity
            android:name=".MoodActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />

        <receiver
            android:name=".ReapplyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="app.lockmein.action.RUN" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <receiver
            android:name=".PackageReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Test build only: the USB way out (adb shell am broadcast -n app.lockmein/.UsbEscapeReceiver). Only the shell holds DUMP. -->
        <receiver
            android:name=".UsbEscapeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Notification access (spec F3): package and time of each notification, and which were tapped; never their text. -->
        <service
            android:name=".NotifyListener"
            android:exported="true"
            android:label="Lock Me In phone use"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".FilterWatcher"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <service
            android:name=".FilterService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/filter_accessibility_service" />
        </service>
    </application>
</manifest>
